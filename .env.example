# ──────────────────────────────────────────────────────────────────────────
# ¿Conviene afuera? — variables de entorno
#
# Copiá este archivo a .env.local y completá lo que necesites.
# NINGUNA de estas variables lleva el prefijo NEXT_PUBLIC_: todas son
# server-only y nunca llegan al navegador.
#
# La app corre ENTERA sin configurar nada: por defecto usa datos mock.
# ──────────────────────────────────────────────────────────────────────────

# ── Providers de búsqueda en el exterior ──────────────────────────────────
# Lista separada por comas: mock | ebay | amazon
# Un provider sin credenciales se descarta solo. Si no queda ninguno, cae a mock.
FOREIGN_SEARCH_PROVIDERS=mock


# ── Mercado Libre (Fase 2) ────────────────────────────────────────────────
# Registrá una app en https://developers.mercadolibre.com.uy/devcenter
# Necesitás una cuenta de ML. La app te da un App ID y un Secret Key.
# Flujo: client credentials → access token (dura 6 h) + refresh token (6 meses).
# Mientras ML_CLIENT_ID esté vacío, ml-reader devuelve datos mock.
ML_CLIENT_ID=
ML_CLIENT_SECRET=


# ── eBay (Fase 3) ─────────────────────────────────────────────────────────
# Registrate en https://developer.ebay.com/ y creá una app de producción.
# Gratis: ~5.000 llamadas/día a la Browse API.
# Auth: OAuth client credentials, scope https://api.ebay.com/oauth/api_scope
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=


# ── Amazon (desactivado en el MVP) ────────────────────────────────────────
# off        → desactivado (default; decisión del MVP)
# rainforest → ~USD 50/mes, devuelve ASIN y peso de envío
# serpapi    → ~USD 75/mes, más genérico
# paapi      → API oficial, gratis, pero exige cuenta de Amazon Associates
#              CON 3 VENTAS CALIFICADAS en 180 días. No implementado.
AMAZON_PROVIDER=off
SERPAPI_KEY=
RAINFOREST_KEY=


# ── Claude (Fase 3: matcher) ──────────────────────────────────────────────
# Sólo se usa cuando el matcher determinístico no puede decidir.
# Modelo elegido: claude-haiku-5-5 (~USD 2 por cada 1.000 consultas).
# Alternativas: claude-sonnet-5-5 (~USD 40) o claude-opus-5-5 (~USD 80).
# Sin esta key, lo que el matcher determinístico no resuelve queda como
# "producto similar (no idéntico)", que es el comportamiento conservador.
ANTHROPIC_API_KEY=
MATCHER_MODEL=claude-haiku-5-5


# ── Cotización del dólar ──────────────────────────────────────────────────
# Valor de respaldo cuando no se puede consultar el BCU. En la Fase 1 es
# siempre este valor, y la UI aclara que es un respaldo.
FX_FALLBACK_USD_UYU=40.5


# ── Rate limiting ─────────────────────────────────────────────────────────
# Consultas por hora y por IP. En memoria: con varias instancias en Vercel
# cada una lleva su propia cuenta, así que el límite efectivo es más laxo.
RATE_LIMIT_PER_HOUR=20
